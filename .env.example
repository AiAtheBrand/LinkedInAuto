# Database configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/linkedin_content

# Security & Session Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# AI Content Generation (Groq)
GROQ_API_KEY=your-groq-api-key

# LinkedIn Developer Application Credentials
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/linkedin/oauth/callback
LINKEDIN_API_VERSION=202401
